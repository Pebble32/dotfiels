export PATH="$HOME/dohop/dohop-dev-tools/bin:$PATH"
export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"
export PATH="/opt/homebrew/opt/redis/bin:$PATH"
export PATH="/opt/homebrew/opt/java/bin:$PATH"

export LC_ALL="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"

export PYTHONPATH="$HOME/dohop/libdohop"

# Git aliases
alias ga="git add"
alias gs="git status"
alias gc="git commit"
alias gch="git checkout"
alias gd="git diff"
alias gb="git branch"

# Tmux aliases
alias tm="tmux new -A -s"
alias tl="tmux ls"
alias ta="tmux attach"
alias tk="tmux kill-session -t"

# Other aliases
alias ll="ls -la"
alias pip="pip3"
alias aws-login="dh-aws login"

# Dohop dev aliases
alias nobs2="dh-python3 -m server.local_dev -s bs2"
alias watchbs2="watchexec -w ../robots -r -e py -- dh-python3 -m server.local_dev --run-only bs2"
alias vi="nvim"
alias denv="source dh-venv"
alias replay="dh-python -m libdohop.agents.restricted_recordings replay -k"

# Airflow
export AIRFLOW__CORE__DAGS_FOLDER=/Users/adampostek/dohop/data-team-tools/dags
export AIRFLOW__CORE__LOAD_EXAMPLES=False
export AIRFLOW__CORE__DAG_RUN_CONF_OVERRIDES_PARAMS=True
export AIRFLOW_CONN_DNA_LAKE='google-cloud-platform://?project=dna-lake'
export GOOGLE_CLOUD_PROJECT=dna-lake

alias gpe="gh pr edit"
alias gpl="gh pr list"
alias gps="gh pr status -c"
alias gpd="gh pr diff"
alias gpa="gh pr review -a"
alias gpv="gh pr view"
alias gpc="gh pr create"
alias gpm="gh pr merge --squash --delete-branch && git fetch -p"
alias gpma="gh pr merge --admin --squash --delete-branch && git fetch -p"
alias gpr="gh pr ready"

alias grl="gh run list"
alias grw="gh run watch"
